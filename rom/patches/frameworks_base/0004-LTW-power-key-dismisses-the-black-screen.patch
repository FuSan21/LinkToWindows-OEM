From: FuSan21 <FuSan21@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:45:46 +0600
Subject: [PATCH] LTW: power key dismisses the black screen

deviceintegrationservice's black screen (type 2099) is not touchable (patch
0003), so the phone user needs another way out. Like OnePlus'
BlackScreenWindowManager.interceptPowerKey: while it is visible and the
screen is on, a power press removes it instead of turning the screen off.

OnePlus delivers the key to the overlay via a custom IWindow method so
deviceintegrationservice hides it itself; stock Android has none, so remove
the window server-side (same path as the client's removeView).
LtwBlackScreenController tracks the window (WindowState.setClientSurface)
and is consulted first in PhoneWindowManager.interceptKeyBeforeQueueing.
---
 .../server/policy/PhoneWindowManager.java     |  6 ++
 .../server/wm/LtwBlackScreenController.java   | 59 +++++++++++++++++++
 .../com/android/server/wm/WindowState.java    |  1 +
 3 files changed, 66 insertions(+)
 create mode 100644 services/core/java/com/android/server/wm/LtwBlackScreenController.java

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index e27b9d2..08282f5 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -5065,6 +5065,12 @@ public class PhoneWindowManager implements WindowManagerPolicy {
     /** {@inheritDoc} */
     @Override
     public int interceptKeyBeforeQueueing(KeyEvent event, int policyFlags) {
+        // Link to Windows: a power press dismisses deviceintegrationservice's black screen first.
+        if (event.getKeyCode() == KeyEvent.KEYCODE_POWER
+                && com.android.server.wm.LtwBlackScreenController.interceptPowerKey(event,
+                        (policyFlags & FLAG_INTERACTIVE) != 0)) {
+            return 0;
+        }
         final int keyCode = event.getKeyCode();
         final boolean down = event.getAction() == KeyEvent.ACTION_DOWN;
         boolean isWakeKey = (policyFlags & WindowManagerPolicy.FLAG_WAKE) != 0
diff --git a/services/core/java/com/android/server/wm/LtwBlackScreenController.java b/services/core/java/com/android/server/wm/LtwBlackScreenController.java
new file mode 100644
index 0000000..5d54c31
--- /dev/null
+++ b/services/core/java/com/android/server/wm/LtwBlackScreenController.java
@@ -0,0 +1,59 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+package com.android.server.wm;
+
+import android.view.KeyEvent;
+
+import java.lang.ref.WeakReference;
+
+/**
+ * Link to Windows OEM integration: deviceintegrationservice's black screen (window type 2099).
+ *
+ * Counterpart of OnePlus' com.android.server.wm.BlackScreenWindowManager: while the black screen
+ * is up, a power press dismisses it instead of turning the screen off. OnePlus hands the key to the
+ * overlay through a custom IWindow method so deviceintegrationservice hides it itself; stock
+ * Android has none, so the window is removed server-side (equivalent to the client's removeView).
+ */
+public final class LtwBlackScreenController {
+    private static WeakReference<WindowState> sWindow;
+    private static boolean sConsumeUp;
+
+    private LtwBlackScreenController() {
+    }
+
+    /** Called with the global lock held when a type-2099 window gets its surface. */
+    static synchronized void onBlackScreenSurface(WindowState win) {
+        sWindow = new WeakReference<>(win);
+    }
+
+    /**
+     * From PhoneWindowManager.interceptKeyBeforeQueueing (input thread, no WM lock).
+     * @return true if the power key event was consumed.
+     */
+    public static synchronized boolean interceptPowerKey(KeyEvent event, boolean interactive) {
+        if (event.getAction() == KeyEvent.ACTION_UP) {
+            final boolean consume = sConsumeUp;
+            sConsumeUp = false;
+            return consume;
+        }
+        if (event.getRepeatCount() > 0) {
+            return sConsumeUp;
+        }
+        final WindowState win = sWindow != null ? sWindow.get() : null;
+        if (!interactive || win == null || win.mRemoved) {
+            return false;
+        }
+        sWindow = null;
+        sConsumeUp = true;
+        final WindowManagerService wms = win.mWmService;
+        wms.mH.post(() -> {
+            synchronized (wms.mGlobalLock) {
+                if (!win.mRemoved && win.isVisible()) {
+                    wms.removeClientToken(win.mSession, win.mClient.asBinder());
+                }
+            }
+        });
+        return true;
+    }
+}
diff --git a/services/core/java/com/android/server/wm/WindowState.java b/services/core/java/com/android/server/wm/WindowState.java
index 9f69ffa..ed658ec 100644
--- a/services/core/java/com/android/server/wm/WindowState.java
+++ b/services/core/java/com/android/server/wm/WindowState.java
@@ -3461,6 +3461,7 @@ class WindowState extends WindowContainer<WindowState> implements WindowManagerP
             // Link to Windows: client-created surfaces bypass WindowStateAnimator's
             // SKIP_SCREENSHOT flag; mark the container so the black screen stays off the PC mirror.
             getPendingTransaction().setSkipScreenshot(mSurfaceControl, true);
+            LtwBlackScreenController.onBlackScreenSurface(this);
         }
         mWinAnimator.resetDrawState();
         setHasSurface(true);
