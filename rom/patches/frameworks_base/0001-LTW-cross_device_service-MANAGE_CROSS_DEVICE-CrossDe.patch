+++ b/core/java/android/app/SystemServiceRegistry.java
@@ -382,6 +382,35 @@ public final class SystemServiceRegistry {
     // Not instantiable.
     private SystemServiceRegistry() { }
 
+    // Link to Windows OEM integration (see registerCrossDeviceService()).
+    private static final String CROSS_DEVICE_SERVICE = "cross_device_service";
+    private static final String CROSS_DEVICE_MANAGER_CLASS = "android.app.CrossDeviceManager";
+
+    /** Key for SYSTEM_SERVICE_NAMES only; never instantiated. */
+    private static final class CrossDeviceServiceMarker {
+        private CrossDeviceServiceMarker() { }
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    private static void registerCrossDeviceService() {
+        // The fetcher returns an instance of the app-side class, so register it raw: erased
+        // generics mean no cast to CrossDeviceServiceMarker ever happens at runtime.
+        final ServiceFetcher fetcher = new CachedServiceFetcher<Object>() {
+            @Override
+            public Object createService(ContextImpl ctx) {
+                try {
+                    final ClassLoader cl = ctx.getClassLoader();
+                    if (cl == null) return null;
+                    return cl.loadClass(CROSS_DEVICE_MANAGER_CLASS)
+                            .getDeclaredConstructor().newInstance();
+                } catch (ReflectiveOperationException | LinkageError e) {
+                    return null; // app does not load com.microsoft.device-private
+                }
+            }
+        };
+        registerService(CROSS_DEVICE_SERVICE, CrossDeviceServiceMarker.class, fetcher);
+    }
+
     static {
         registerServices();
     }
