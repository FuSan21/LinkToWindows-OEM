From 5ee31c91b30b86e9295c8a571576e94667f35dc0 Mon Sep 17 00:00:00 2001
From: FuSan21 <35169687+FuSan21@users.noreply.github.com>
Date: Tue, 24 Nov 2026 07:13:56 +0600
Subject: [PATCH] LTW: black screen V2 - broker-owned black screen

deviceintegrationservice draws the black screen through the cross-device
broker (showBlackScreen/hideBlackScreen) when the broker holds MONITOR_INPUT.
The broker adds a type-2099 window and blocks the phone's own touches with a
gesture monitor.

- PhoneWindowManager.checkAddPermission: allow 2098/2099 for the broker as
  well as for deviceintegrationservice.
- LtwBlackScreenController.interceptPowerKey: if the broker owns the black
  screen, ask it to hide (broadcast HIDE_BLACK_SCREEN, receiver requires
  MONITOR_INPUT) so it also drops its gesture monitor, instead of removing
  the window server-side.
---
 .../server/policy/PhoneWindowManager.java       | 11 +++++++++--
 .../server/wm/LtwBlackScreenController.java     | 17 +++++++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 08282f5..aaff633 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -3653,7 +3653,11 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 && mWakeGestureListener.isSupported();
     }
 
-    /** == CrossDeviceManager.isCallerAllowed() (com.microsoft.device-private), for the caller. */
+    /**
+     * == CrossDeviceManager.isCallerAllowed() (com.microsoft.device-private), for the caller, plus
+     * the cross-device broker, which draws the black screen itself in deviceintegrationservice's
+     * "V2" mode (broker holds MONITOR_INPUT).
+     */
     private boolean isLtwCrossDeviceCaller() {
         if (mContext.checkCallingPermission("deviceintegration.permission.MANAGE_CROSS_DEVICE")
                 != PERMISSION_GRANTED) {
@@ -3665,7 +3669,10 @@ public class PhoneWindowManager implements WindowManagerPolicy {
             final String[] pkgs = mContext.getPackageManager().getPackagesForUid(uid);
             if (pkgs == null) return false;
             for (String p : pkgs) {
-                if ("com.microsoft.deviceintegrationservice".equals(p)) return true;
+                if ("com.microsoft.deviceintegrationservice".equals(p)
+                        || "com.microsoftsdk.crossdeviceservicebroker".equals(p)) {
+                    return true;
+                }
             }
             return false;
         } finally {
diff --git a/services/core/java/com/android/server/wm/LtwBlackScreenController.java b/services/core/java/com/android/server/wm/LtwBlackScreenController.java
index 5d54c31..c345aa3 100644
--- a/services/core/java/com/android/server/wm/LtwBlackScreenController.java
+++ b/services/core/java/com/android/server/wm/LtwBlackScreenController.java
@@ -3,6 +3,8 @@
  */
 package com.android.server.wm;
 
+import android.content.Intent;
+import android.os.UserHandle;
 import android.view.KeyEvent;
 
 import java.lang.ref.WeakReference;
@@ -14,8 +16,17 @@ import java.lang.ref.WeakReference;
  * is up, a power press dismisses it instead of turning the screen off. OnePlus hands the key to the
  * overlay through a custom IWindow method so deviceintegrationservice hides it itself; stock
  * Android has none, so the window is removed server-side (equivalent to the client's removeView).
+ *
+ * Black screen "V2": when the cross-device broker owns the window (deviceintegrationservice uses
+ * the broker's showBlackScreen because the broker holds MONITOR_INPUT), the broker is asked to hide
+ * it instead, so it also stops its gesture monitor (which blocks the phone's own touches).
  */
 public final class LtwBlackScreenController {
+    private static final String BROKER_PACKAGE = "com.microsoftsdk.crossdeviceservicebroker";
+    /** Broker BlackScreen.ACTION_HIDE; its receiver requires the sender to hold MONITOR_INPUT. */
+    private static final String ACTION_HIDE_BLACK_SCREEN =
+            "com.microsoftsdk.crossdeviceservicebroker.action.HIDE_BLACK_SCREEN";
+
     private static WeakReference<WindowState> sWindow;
     private static boolean sConsumeUp;
 
@@ -47,6 +58,12 @@ public final class LtwBlackScreenController {
         sWindow = null;
         sConsumeUp = true;
         final WindowManagerService wms = win.mWmService;
+        if (BROKER_PACKAGE.equals(win.getOwningPackage())) {
+            final UserHandle user = UserHandle.getUserHandleForUid(win.getOwningUid());
+            wms.mH.post(() -> wms.mContext.sendBroadcastAsUser(
+                    new Intent(ACTION_HIDE_BLACK_SCREEN).setPackage(BROKER_PACKAGE), user));
+            return true;
+        }
         wms.mH.post(() -> {
             synchronized (wms.mGlobalLock) {
                 if (!win.mRemoved && win.isVisible()) {
-- 
